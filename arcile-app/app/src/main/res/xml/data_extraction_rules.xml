<?xml version="1.0" encoding="utf-8"?>
<!--
   Android backup excludes device-bound or rebuildable state: trash and vault keys, operation
   journals and staging, the thumbnail and index cache, and every DataStore file (settings move
   between devices through Arcile's own preferences backup instead).
   Used on Android 12 and newer; backup_rules.xml must list the same paths.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="trash_crypto_prefs.xml" />
        <exclude domain="sharedpref" path="operation_journal.xml" />
        <exclude domain="sharedpref" path="mutation_journal.xml" />
        <exclude domain="sharedpref" path="onlyfiles_vault_locations.xml" />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="analytics" />
        <exclude domain="file" path="operation_journal" />
        <exclude domain="file" path="staging" />
        <exclude domain="file" path=".arcile" />
        <exclude domain="external" path=".arcile" />
        <exclude domain="database" path="arcile-cache.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="trash_crypto_prefs.xml" />
        <exclude domain="sharedpref" path="operation_journal.xml" />
        <exclude domain="sharedpref" path="mutation_journal.xml" />
        <exclude domain="sharedpref" path="onlyfiles_vault_locations.xml" />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="analytics" />
        <exclude domain="file" path="operation_journal" />
        <exclude domain="file" path="staging" />
        <exclude domain="file" path=".arcile" />
        <exclude domain="external" path=".arcile" />
        <exclude domain="database" path="arcile-cache.db" />
    </device-transfer>
</data-extraction-rules>
